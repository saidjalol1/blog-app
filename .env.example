# Django Blog Application - Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Django Secret Key
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production

# Allowed Hosts (comma-separated list of domains)
# Example: example.com,www.example.com,blog.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration - Option 1: Single URL (Recommended)
# PostgreSQL: postgresql://user:password@host:port/database
# MySQL: mysql://user:password@host:port/database
DATABASE_URL=postgresql://bloguser:password@localhost:5432/blogdb

# Database Configuration - Option 2: Individual Variables
# Uncomment and use these if not using DATABASE_URL
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=blogdb
# DB_USER=bloguser
# DB_PASSWORD=your_database_password
# DB_HOST=localhost
# DB_PORT=5432

# =============================================================================
# OPTIONAL SETTINGS (with defaults)
# =============================================================================

# Debug Mode (MUST be False in production)
# Options: True, False, 1, 0, yes, no
DJANGO_DEBUG=False

# Redis Cache URL
# Format: redis://host:port/db
# With password: redis://:password@host:port/db
REDIS_URL=redis://127.0.0.1:6379/1

# =============================================================================
# ERROR TRACKING (Optional but recommended for production)
# =============================================================================

# Sentry DSN (get from your Sentry project settings)
# Example: https://abc123@o123456.ingest.sentry.io/7890123
# SENTRY_DSN=

# Sentry Performance Monitoring Sample Rate (0.0 to 1.0)
# 0.1 = 10% of transactions, 1.0 = 100% of transactions
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry Environment Name
# Options: production, staging, development
# SENTRY_ENVIRONMENT=production

# =============================================================================
# ENVIRONMENT-SPECIFIC EXAMPLES
# =============================================================================

# --- Development Environment ---
# DJANGO_SECRET_KEY=dev-secret-key-not-for-production
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgresql://bloguser:password@localhost:5432/blogdb_dev
# REDIS_URL=redis://127.0.0.1:6379/0
# SENTRY_ENVIRONMENT=development

# --- Staging Environment ---
# DJANGO_SECRET_KEY=staging-secret-key-unique-per-environment
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=staging.example.com
# DATABASE_URL=postgresql://bloguser:password@staging-db.example.com:5432/blogdb_staging
# REDIS_URL=redis://staging-redis.example.com:6379/1
# SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/7890123
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=staging

# --- Production Environment ---
# DJANGO_SECRET_KEY=production-secret-key-50-plus-characters-recommended
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DATABASE_URL=postgresql://bloguser:secure_password@prod-db.example.com:5432/blogdb
# REDIS_URL=redis://prod-redis.example.com:6379/1
# SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/7890123
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=production

# =============================================================================
# NOTES
# =============================================================================

# 1. Copy this file to .env in the project root
# 2. Update all values with your actual configuration
# 3. Ensure .env is in .gitignore (never commit secrets!)
# 4. Use different values for each environment (dev, staging, prod)
# 5. Generate a unique DJANGO_SECRET_KEY for each environment
# 6. Set DJANGO_DEBUG=False in production
# 7. Configure HTTPS on your web server before deploying to production
# 8. Verify database and Redis are accessible before starting the application

# For more information, see docs/ENVIRONMENT_VARIABLES.md
